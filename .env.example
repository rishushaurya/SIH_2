# ==============================================================================
# MahaLink Environment Configuration (SIH26129)
# Run `npm run env:init` to create .env with every __GENERATE_*__ value replaced by a random secret.
# The same .env drives `npm run dev` on the host and `docker compose` (variable interpolation).
# ==============================================================================

NODE_ENV=development
PORT=5000
# true: demo personas + seed-fixture fallback when a department database is offline. false: real deployment.
DEMO_MODE=true
# Reverse-proxy hops to trust (1 when running behind the nginx TLS proxy / a load balancer)
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secrets (HS256 session signing, HMAC pepper for Aadhaar/identity hashing)
JWT_SECRET=__GENERATE_JWT_SECRET__
AADHAAR_PEPPER=__GENERATE_AADHAAR_PEPPER__

# Persistent state: append-only audit ledger + Consent Authority ES256 key (auto-created, chmod 600)
AUDIT_LOG_PATH=./data/audit-ledger.jsonl
CONSENT_KEY_FILE=./data/consent-signing-key.pem

# ------------------------------------------------------------------------------
# Department databases (`npm run docker:db` starts all three on localhost)
# DB_ADMIN_PASSWORD  : department DBA account, used only by the seeder and the live-ingest demo
# DB_READER_PASSWORD : SELECT-only account MahaLink adapters use (created by the seeder)
# ------------------------------------------------------------------------------
DB_ADMIN_PASSWORD=__GENERATE_DB_ADMIN_PASSWORD__
DB_READER_PASSWORD=__GENERATE_DB_READER_PASSWORD__

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=maha_revenue
PG_USER=mahalink_reader
PG_PASSWORD=__GENERATE_DB_READER_PASSWORD__
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=__GENERATE_DB_ADMIN_PASSWORD__
PG_SSL=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=maha_rto
MYSQL_USER=mahalink_reader
MYSQL_PASSWORD=__GENERATE_DB_READER_PASSWORD__
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=__GENERATE_DB_ADMIN_PASSWORD__
MYSQL_SSL=false

MONGO_URI=mongodb://mahalink_reader:__GENERATE_DB_READER_PASSWORD__@localhost:27017/maha_certificates?authSource=maha_certificates
MONGO_ADMIN_URI=mongodb://root:__GENERATE_DB_ADMIN_PASSWORD__@localhost:27017/maha_certificates?authSource=admin

# Education board legacy CSV dumps (every *.csv in this directory is read)
CSV_DATA_DIR=./src/db/files

# ------------------------------------------------------------------------------
# Meri Pehchaan / DigiLocker OAuth 2.0 + PKCE (leave blank to use demo login only).
# Production: endpoints and client credentials issued by NeGD on partner registration.
# Local testing: any OIDC provider, e.g. Keycloak realm endpoints.
# ------------------------------------------------------------------------------
OIDC_PROVIDER_NAME=Meri Pehchaan
OIDC_ISSUER=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_SCOPE=openid
# Claim holding the citizen identifier. A 12-digit Aadhaar-valued claim links to department records.
OIDC_ID_CLAIM=sub
OIDC_NAME_CLAIM=name
# Comma-separated identifiers that receive the SYS_ADMIN role
ADMIN_SUBJECTS=
