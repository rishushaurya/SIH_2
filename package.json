{
  "name": "mahalink-monorepo",
  "version": "1.0.0",
  "description": "Maharashtra Federated Interoperability & Consent Middleware (SIH26129)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "npm --prefix client run dev",
    "build": "tsc -p tsconfig.json && npm --prefix client run build",
    "start": "node dist/index.js",
    "setup": "npm install && npm --prefix client install",
    "env:init": "node scripts/env-init.js",
    "docker:up": "docker compose up -d --build",
    "docker:db": "docker compose up -d --build seed",
    "docker:down": "docker compose down -v",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts --reset",
    "demo:ingest": "tsx src/db/ingestCitizen.ts",
    "certs:dev": "node -e \"require('fs').mkdirSync('nginx/certs',{recursive:true})\" && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 365 -subj /CN=localhost -addext subjectAltName=DNS:localhost -keyout nginx/certs/tls.key -out nginx/certs/tls.crt",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/integration",
    "test:security": "vitest run test/integration/api.test.ts test/integration/oidc.test.ts test/unit/consent.test.ts test/unit/audit.test.ts",
    "test:tamper": "tsx scripts/testTamper.ts",
    "verify": "npm run build && npm test && npm audit --omit=dev",
    "certs:mtls": "sh scripts/mtls-certs.sh"
  },
  "dependencies": {
    "cors": "2.8.5",
    "csv-parser": "3.0.0",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "6.5.0",
    "mysql2": "3.24.6",
    "pg": "8.11.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/pg": "8.11.5",
    "concurrently": "8.2.2",
    "tsx": "4.23.15",
    "typescript": "5.4.5",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
