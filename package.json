{
  "name": "mahalink-monorepo",
  "version": "1.0.0",
  "description": "Maharashtra Federated Interoperability & Consent Middleware (SIH26129)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "npm --prefix client run dev",
    "build": "tsc -b && cd client && npm run build",
    "setup": "npm install && npm --prefix client install",
    "env:init": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.copyFileSync('.env.example', '.env');\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts",
    "diagnostics": "node scripts/diagnostics.js",
    "diagnostics:ts": "tsx scripts/diagnostics.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/integration",
    "test:security": "tsx scripts/securityAudit.ts",
    "test:tamper": "tsx scripts/testTamper.ts",
    "verify": "tsx scripts/finalVerification.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "csv-parser": "3.0.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.5.0",
    "mysql2": "3.9.7",
    "pg": "8.11.5",
    "uuid": "9.0.1",
    "winston": "3.13.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/pg": "8.11.5",
    "@types/uuid": "9.0.8",
    "concurrently": "8.2.2",
    "tsx": "4.7.2",
    "typescript": "5.4.5",
    "vitest": "1.5.0"
  }
}
